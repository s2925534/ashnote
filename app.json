{
  "expo": {
    "name": "Ashnote",
    "slug": "ashnote",
    "version": "0.4.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.velosolabs.ashnote",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Ashnote uses the camera to scan invite codes and to take a photo you choose to send.",
        "NSLocationWhenInUseUsageDescription": "Ashnote reads your location only when you send an SOS or Help alert, and sends it encrypted to the contacts you alert.",
        "NSPhotoLibraryUsageDescription": "Ashnote opens your photos only so you can pick one to send."
      },
      "associatedDomains": [
        "applinks:velosolabs.com"
      ]
    },
    "android": {
      "package": "com.velosolabs.ashnote",
      "versionCode": 6,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#0B1020",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "velosolabs.com",
              "pathPrefix": "/ashnote/i"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ashnote uses the camera to scan invite codes and to take a photo you choose to send.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0B1020"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ashnote reads your location only when you send an SOS or Help alert, and sends it encrypted to the contacts you alert.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ashnote opens your photos only so you can pick one to send.",
          "cameraPermission": "Ashnote uses the camera to scan invite codes and to take a photo you choose to send.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "ashnote",
    "description": "Private chat with no accounts and no server: single-use QR pairing, aliases made from keys, messages that delete themselves after reading."
  }
}
